{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "baseUrl": ".",
    "paths": {
      "~/*": ["packages/app/src/*"],
      "@sentry-tui/app/*": ["packages/app/src/*"],
      "@sentry-tui/runtime-contract/*": ["packages/runtime-contract/src/*"],
      "@sentry-tui/runtime-host/*": ["packages/runtime-host/src/*"],
      "@sentry-tui/launcher/*": ["packages/launcher/src/*"]
    }
  },
  "include": ["packages", "test", "scripts", "demos"]
}
