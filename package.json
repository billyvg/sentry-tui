{
  "name": "sentry-tui",
  "version": "0.8.0",
  "private": true,
  "description": "sentry.io in your terminal — a TUI client for Sentry",
  "homepage": "https://github.com/billyvg/sentry-tui#readme",
  "bugs": {
    "url": "https://github.com/billyvg/sentry-tui/issues"
  },
  "license": "MIT",
  "author": "Billy Vong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billyvg/sentry-tui.git"
  },
  "bin": {
    "sentry-tui": "src/main.tsx"
  },
  "type": "module",
  "module": "src/main.tsx",
  "scripts": {
    "start": "bun run src/main.tsx",
    "dev": "bun --watch src/main.tsx",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix",
    "test": "bun test ./src ./test ./demos",
    "test:shard": "bun run ./scripts/test-shard.ts",
    "test:parallel": "bun run ./scripts/test-parallel.ts",
    "test:theme-contrast": "bun test scripts/check-theme-contrast.test.ts",
    "test:boundaries": "bun test scripts/source-boundaries.test.ts",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "deps:baseline": "depcruise src --config .dependency-cruiser.cjs --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "test:packaging": "bun test scripts/packaging.test.ts",
    "build:bin": "bun run ./scripts/build-bin.ts",
    "build:npm": "bun run ./scripts/build-npm.ts",
    "build:formula": "bun run ./scripts/build-formula.ts",
    "icons:build": "bun run ./scripts/build-platform-icons.ts",
    "release:preflight": "bun run ./scripts/release.ts preflight",
    "release:dry-run": "bun run ./scripts/release.ts dry-run",
    "release:cut": "bun run ./scripts/release.ts cut",
    "release:publish": "bun run ./scripts/release.ts publish",
    "release:verify": "bun run ./scripts/release.ts verify",
    "demo:seer-prep": "bun run ./demos/seer-prep.ts",
    "demo:tts": "bun run ./demos/tts.ts",
    "demo:record": "bun run ./demos/record.ts",
    "demo:mux": "bun run ./demos/mux.ts",
    "demo": "bun run demo:tts && bun run demo:record && bun run demo:mux",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run deps:check && bun run test:parallel",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "@sentry/api": "0.272.0",
    "@sentry/bun": "^10.70.0",
    "react": "^19.2.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "dependency-cruiser": "^18.2.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "platformicons": "9.6.0",
    "simple-git-hooks": "2.12.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "//": "Never published. The npm packages are generated by scripts/build-npm.ts; this manifest only drives development, and `version` is the single source of truth for a release."
}
